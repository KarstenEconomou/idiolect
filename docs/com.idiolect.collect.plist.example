<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.idiolect.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>set -a; source REPO_PATH/.env; set +a; exec UV_PATH run idiolect signal collect --follow</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPO_PATH</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>REPO_PATH/var/log/collect.out.log</string>

    <key>StandardErrorPath</key>
    <string>REPO_PATH/var/log/collect.err.log</string>
</dict>
</plist>
